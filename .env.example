APP_ENV=development

MAX_SOURCE_CHARS=50000
MAX_ARRAY_LENGTH=500
MAX_REQUEST_BYTES=100000

RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60

HOST_PORT=8000

# Direct local server defaults. Compose has its own explicit environment block.
CHALLENGE_MODE_ENABLED=1
CHALLENGE_DB_BACKEND=sqlite
CHALLENGE_TEST_VERSION=sorting-15-v2
# Keep detailed answers private until course staff explicitly release them.
CHALLENGE_FEEDBACK_RELEASED=0

# Azure Container App environment variables (these are identifiers, not secrets).
# Set CHALLENGE_DB_BACKEND=azure_sql in Azure only after schema/grants are ready.
CHALLENGE_SQL_SERVER=sorting-visualizer-sql-dhp005.database.windows.net
CHALLENGE_SQL_DATABASE=sorting-challenge-db
CHALLENGE_SQL_CLIENT_ID=your-managed-identity-client-id
